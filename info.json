{
  "id": "plugin.com.elio.programmer-selection-translator",
  "plugin_type": "translate",
  "icon": "icon.svg",
  "display": "程序员划词翻译",
  "homepage": "https://github.com/elio-zwd/pot-app-translate-plugin-programmer-selection",
  "needs": [
    {
      "key": "outputStyle",
      "display": "输出格式",
      "type": "select",
      "options": {
        "report": "完整分析",
        "camel": "camelCase",
        "pascal": "PascalCase",
        "snake": "snake_case",
        "screaming": "SCREAMING_SNAKE_CASE",
        "kebab": "kebab-case",
        "words": "拆分词组",
        "chinese": "仅中文含义"
      }
    },
    {
      "key": "dictionaryMode",
      "display": "本地词典显示",
      "type": "select",
      "options": {
        "both": "编程术语 + 普通词义",
        "programming": "仅编程术语优先",
        "general": "仅普通英语词典"
      }
    },
    {
      "key": "identifierType",
      "display": "标识符类型",
      "type": "select",
      "options": {
        "auto": "自动判断",
        "function": "函数名",
        "variable": "变量名",
        "boolean": "布尔变量",
        "class": "类名",
        "constant": "常量/宏",
        "file": "文件名"
      }
    },
    {
      "key": "acronymStyle",
      "display": "缩写格式",
      "type": "select",
      "options": {
        "standard": "标准驼峰（HTTP → Http）",
        "preserve": "保留大写（HTTP → HTTP）"
      }
    },
    {
      "key": "aiMode",
      "display": "Gemini 语义增强",
      "type": "select",
      "options": {
        "off": "关闭（默认，零网络请求）",
        "unknown_only": "仅本地未知词",
        "always": "始终增强"
      }
    },
    {
      "key": "apiKeyPool",
      "display": "Gemini Key 池（设置页明文，# 前缀禁用）",
      "type": "input"
    },
    {
      "key": "maxKeyAttempts",
      "display": "单次最多尝试不同 Key 数",
      "type": "select",
      "options": {
        "5": "5（默认）",
        "1": "1",
        "3": "3",
        "10": "10",
        "20": "20"
      }
    },
    {
      "key": "modelPreset",
      "display": "Gemini 模型",
      "type": "select",
      "options": {
        "gemini-3.5-flash-lite": "Gemini 3.5 Flash-Lite（默认，快速低成本）",
        "gemini-3.6-flash": "Gemini 3.6 Flash",
        "gemini-3.5-flash": "Gemini 3.5 Flash",
        "gemini-3.1-flash-lite": "Gemini 3.1 Flash-Lite",
        "custom": "自定义模型"
      }
    },
    {
      "key": "customModel",
      "display": "自定义 Gemini 模型 ID",
      "type": "input"
    },
    {
      "key": "sendScope",
      "display": "Gemini 发送范围",
      "type": "select",
      "options": {
        "unknown_tokens": "仅 token（默认）",
        "identifier": "完整标识符"
      }
    }
  ],
  "language": {
    "auto": "auto",
    "zh_cn": "zh_cn",
    "zh_tw": "zh_tw",
    "en": "en"
  }
}
